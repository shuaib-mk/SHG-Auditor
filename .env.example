# SHG Auditor - Environment Configuration
PORT=3005
NODE_ENV=development

# Agent Provider selection: 'meta' | 'baseten' | 'mock'
# If keys are left blank, server defaults gracefully to 'mock' mode with realistic Indian SHG synthetic datasets
AGENT_PROVIDER=mock

# Meta Model API (Official Endpoint)
# Muse Voice Transcribe: speech-to-text with speaker diarization & Indian code-switching (Hindi, English, Tamil, Kannada)
# Muse Spark: multimodal agent with tool calling and document/register vision
META_MODEL_BASE_URL=https://api.meta.com/v1
META_MODEL_API_KEY=
META_VOICE_MODEL=muse-voice-transcribe
META_SPARK_MODEL=muse-spark

# Baseten Model API Alternative (OpenAI compatible chat-completions endpoint)
# Swappable Muse Spark Open deployment
BASETEN_BASE_URL=https://bridge.baseten.co/v1
BASETEN_API_KEY=
BASETEN_MODEL_ID=meta-models/muse-spark-open-1026

# Limits & Invariants
MAX_AUDIO_SIZE_MB=25
MAX_IMAGE_SIZE_MB=10
DEFAULT_SAVINGS_QUOTA=200
DEFAULT_INTEREST_RATE_PERCENT=2.0
